# Caddyfile for Secure Cloud Storage

# Local HTTP development
http://localhost:8000, http://127.0.0.1:8000 {
    # Reasonable upload limits (100MB)
    request_body {
        max_size 100MB
    }

    reverse_proxy scs-server:8000

    # Ensure security headers are passed
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    # Logging - disable headers logging to protect Authorization headers
    log {
        output stdout
        format filter {
            wrap console
            fields {
                request>headers>Authorization delete
            }
        }
    }
}

# Production HTTPS (Tailscale or internal DNS)
# You can override this hostname via environment variables in docker-compose.yml
# e.g., https://{$DOMAIN_NAME}
https://{$DOMAIN_NAME:scs.internal} {
    # Use internal self-signed TLS for local/private network
    # For a public domain, remove 'tls internal' and Caddy will auto-provision Let's Encrypt certificates
    tls internal

    request_body {
        max_size 100MB
    }

    reverse_proxy scs-server:8000

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    log {
        output stdout
        format filter {
            wrap console
            fields {
                request>headers>Authorization delete
            }
        }
    }
}
